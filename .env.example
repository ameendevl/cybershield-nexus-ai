# CyberShield Nexus Enterprise & SOC Auth Configuration
# Environment variables template - NEVER commit production secrets

# Public Frontend API URL (leave empty for same-domain /api relative path)
VITE_API_BASE_URL=

# Clerk Authentication Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Google OAuth Client ID (optional)
VITE_GOOGLE_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com

# Backend Service Port
PORT=4000

# Backend ReqRes Cloud API Key (Optional)
REQRES_API_KEY=
